{
  "info": {
    "name": "Practica 14 - Pokemon API REST",
    "description": "Ejecutar en orden. Primero iniciar MySQL y Spring Boot. Guardar capturas reales de cada prueba en la carpeta Postman.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - POST Crear Pikachu",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/pokemones",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "pokemones"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Pikachu\",\n  \"tipo\": \"Electrico\",\n  \"nivel\": 10,\n  \"ataque\": 55,\n  \"defensa\": 40,\n  \"descripcion\": \"Pokemon de tipo electrico\",\n  \"imagenUrl\": \"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/25.png\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Creado\", () => pm.response.to.have.status(200));",
              "const data = pm.response.json();",
              "pm.collectionVariables.set(\"pokemonId\", data.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - GET Obtener todos",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/pokemones",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "pokemones"
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Lista obtenida\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - GET Obtener por ID",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/pokemones/{{pokemonId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "pokemones",
            "{{pokemonId}}"
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Pokemon obtenido\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - PUT Actualizar completo",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/pokemones/{{pokemonId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "pokemones",
            "{{pokemonId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Pikachu\",\n  \"tipo\": \"Electrico\",\n  \"nivel\": 15,\n  \"ataque\": 60,\n  \"defensa\": 40,\n  \"descripcion\": \"Pokemon de tipo electrico\",\n  \"imagenUrl\": \"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/25.png\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Actualizado por completo\", () => pm.response.to.have.status(200));",
              "pm.test(\"Nivel 15\", () => pm.expect(pm.response.json().nivel).to.eql(15));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - PATCH Actualizar nivel",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/pokemones/{{pokemonId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "pokemones",
            "{{pokemonId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nivel\": 20\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Actualizado parcialmente\", () => pm.response.to.have.status(200));",
              "pm.test(\"Nivel 20\", () => pm.expect(pm.response.json().nivel).to.eql(20));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 - DELETE Eliminar Pokemon",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/pokemones/{{pokemonId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "pokemones",
            "{{pokemonId}}"
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Eliminado\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "pokemonId",
      "value": "1"
    }
  ]
}
